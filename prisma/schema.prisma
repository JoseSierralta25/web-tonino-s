generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Category {
  id         String    @id @default(cuid())
  name       String    @unique
  sortOrder  Int       @default(0)
  isActive   Boolean   @default(true)
  products   Product[]
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
}

model Product {
  id          String        @id @default(cuid())
  name        String
  description String?
  isFavorite  Boolean       @default(false)
  isActive    Boolean       @default(true)
  imageUrl    String?
  sortOrder   Int           @default(0)
  categoryId  String
  category    Category      @relation(fields: [categoryId], references: [id])
  sizes       ProductSize[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

model ProductSize {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  size      String  // "P" | "R" | "XL" | "UNICO"
  price     Float

  @@unique([productId, size])
}

model Promotion {
  id          String   @id @default(cuid())
  name        String
  description String?
  label       String?
  price       Float
  imageUrl    String?
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Location {
  id              String   @id @default(cuid())
  name            String
  whatsappNumber  String
  mapsEmbedUrl    String?
  isActive        Boolean  @default(true)
  sortOrder       Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}
